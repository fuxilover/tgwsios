<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.tgwsproxy</string>
    <key>Program</key>
    <string>/usr/bin/tgwsproxyd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/tgwsproxyd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/tgwsproxy.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/tgwsproxy.log</string>
    <key>ThrottleInterval</key>
    <integer>3</integer>
</dict>
</plist>
